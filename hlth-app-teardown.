<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>HLTH companion app — teardown & Today screen spec</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --ground:#E7EAEE;
  --panel:#FFFFFF;
  --ink:#151A21;
  --ink-2:#4C5563;
  --ink-3:#7C8695;
  --rule:#D0D5DC;
  --rule-2:#E3E6EB;
  --flag:#93222B;
  --flag-bg:#F6E9EA;
  --ok:#0E6153;

  --dev-surface:#0A0C10;
  --dev-raised:#161A22;
  --dev-line:#242A34;
  --dev-text:#F1F4F8;
  --dev-dim:#858F9E;
  --dev-accent:#8D95F6;
  --dev-warn:#D9A05B;

  --sans:'IBM Plex Sans',system-ui,-apple-system,sans-serif;
  --mono:'IBM Plex Mono',ui-monospace,monospace;
}

*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%}
body{
  margin:0;
  background:var(--ground);
  color:var(--ink);
  font-family:var(--sans);
  font-size:16px;
  line-height:1.55;
  -webkit-font-smoothing:antialiased;
}

/* graph-paper ground, like a lab printout */
body::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  background-image:
    linear-gradient(to right,rgba(21,26,33,.045) 1px,transparent 1px),
    linear-gradient(to bottom,rgba(21,26,33,.045) 1px,transparent 1px);
  background-size:28px 28px;
  z-index:0;
}

.wrap{
  position:relative;
  z-index:1;
  max-width:1080px;
  margin:0 auto;
  padding:0 24px 96px;
}

a{color:inherit}
:focus-visible{outline:2px solid var(--ink);outline-offset:3px}

/* ---------- type ---------- */
.eyebrow{
  font-family:var(--mono);
  font-size:11px;
  font-weight:500;
  letter-spacing:.13em;
  text-transform:uppercase;
  color:var(--ink-3);
}
h1{
  font-size:clamp(34px,5.4vw,58px);
  line-height:1.02;
  letter-spacing:-.032em;
  font-weight:600;
  margin:18px 0 0;
  max-width:15ch;
}
h2{
  font-size:clamp(21px,2.6vw,27px);
  line-height:1.15;
  letter-spacing:-.022em;
  font-weight:600;
  margin:0;
}
h3{
  font-size:16px;
  letter-spacing:-.008em;
  font-weight:600;
  margin:0 0 6px;
}
p{margin:0 0 14px;max-width:66ch}
.lede{font-size:clamp(17px,2vw,19px);line-height:1.5;color:var(--ink-2);max-width:58ch}
strong{font-weight:600}

/* ---------- masthead ---------- */
.masthead{padding:64px 0 40px;border-bottom:1.5px solid var(--ink)}
.byline{
  display:flex;
  flex-wrap:wrap;
  gap:8px 28px;
  margin-top:32px;
  font-family:var(--mono);
  font-size:12px;
  color:var(--ink-2);
}
.byline b{font-weight:500;color:var(--ink)}

/* ---------- sections ---------- */
section{padding:52px 0;border-bottom:1px solid var(--rule)}
.sec-head{
  display:grid;
  grid-template-columns:56px 1fr;
  gap:0 20px;
  align-items:baseline;
  margin-bottom:26px;
}
.sec-num{
  font-family:var(--mono);
  font-size:12px;
  font-weight:500;
  color:var(--ink-3);
  padding-top:6px;
}
.sec-body{grid-column:2}
@media(max-width:640px){
  .sec-head{grid-template-columns:1fr;gap:6px}
  .sec-body{grid-column:1}
}

/* ---------- evidence rail ---------- */
.rail{border-top:1px solid var(--rule)}
.finding{
  display:grid;
  grid-template-columns:56px 1fr 200px;
  gap:0 20px;
  padding:22px 0;
  border-bottom:1px solid var(--rule-2);
  align-items:start;
}
.finding:last-child{border-bottom:0}
.f-id{
  font-family:var(--mono);
  font-size:12px;
  color:var(--ink-3);
  padding-top:2px;
}
.f-main p{margin:0;color:var(--ink-2);font-size:15px;max-width:60ch}
.f-main h3{display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
.tag{
  font-family:var(--mono);
  font-size:10px;
  letter-spacing:.09em;
  text-transform:uppercase;
  padding:2px 7px;
  border-radius:2px;
  font-weight:500;
  white-space:nowrap;
}
.tag.sev{background:var(--flag-bg);color:var(--flag)}
.tag.brand{background:#EAEDF6;color:#2F3E7A}
.f-src{
  font-family:var(--mono);
  font-size:11.5px;
  line-height:1.5;
  color:var(--ink-3);
  padding-top:3px;
  border-left:1px solid var(--rule);
  padding-left:16px;
}
@media(max-width:820px){
  .finding{grid-template-columns:40px 1fr}
  .f-src{grid-column:2;border-left:0;padding-left:0;margin-top:10px;border-top:1px dashed var(--rule);padding-top:8px}
}

/* ---------- spec panel ---------- */
.panel{
  background:var(--panel);
  border:1px solid var(--rule);
  padding:26px 28px;
  margin-bottom:16px;
}
.panel h3{
  font-family:var(--mono);
  font-size:11px;
  letter-spacing:.13em;
  text-transform:uppercase;
  color:var(--ink-3);
  font-weight:500;
  margin-bottom:14px;
}
.spec-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:760px){.spec-grid{grid-template-columns:1fr}}

ul.tight{margin:0;padding-left:0;list-style:none}
ul.tight li{
  padding:7px 0 7px 0;
  border-bottom:1px solid var(--rule-2);
  font-size:14.5px;
  color:var(--ink-2);
}
ul.tight li:last-child{border-bottom:0}
ul.tight li b{color:var(--ink);font-weight:600}
code{
  font-family:var(--mono);
  font-size:12.5px;
  background:#EDF0F3;
  padding:1px 5px;
  border-radius:2px;
  color:var(--ink);
}

/* acceptance criteria */
.ac{display:grid;grid-template-columns:56px 1fr;gap:0 20px;padding:11px 0;border-bottom:1px solid var(--rule-2);font-size:14.5px;color:var(--ink-2)}
.ac:last-child{border-bottom:0}
.ac span{font-family:var(--mono);font-size:12px;color:var(--flag);font-weight:500}

/* ---------- phones ---------- */
.phones{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:26px;
  margin-top:8px;
}
@media(max-width:900px){.phones{grid-template-columns:1fr;max-width:340px;margin-inline:auto}}

.state-label{
  font-family:var(--mono);
  font-size:11px;
  letter-spacing:.1em;
  text-transform:uppercase;
  color:var(--ink-3);
  margin-bottom:10px;
  display:flex;
  justify-content:space-between;
  gap:8px;
}
.state-label b{color:var(--ink);font-weight:500}
.state-note{font-size:13px;color:var(--ink-2);margin:12px 0 0;line-height:1.45}

.phone{
  background:var(--dev-surface);
  border:1px solid #000;
  border-radius:26px;
  padding:14px 15px 18px;
  color:var(--dev-text);
  box-shadow:0 1px 0 rgba(255,255,255,.5) inset,0 18px 34px -20px rgba(10,14,20,.5);
  font-size:14px;
}
.status{
  display:flex;
  justify-content:space-between;
  font-family:var(--mono);
  font-size:10px;
  color:var(--dev-dim);
  padding:2px 4px 14px;
  letter-spacing:.02em;
}
.p-date{
  font-family:var(--mono);
  font-size:10.5px;
  letter-spacing:.11em;
  text-transform:uppercase;
  color:var(--dev-dim);
  padding:0 4px;
}
.p-kicker{
  font-family:var(--mono);
  font-size:10px;
  letter-spacing:.13em;
  text-transform:uppercase;
  color:var(--dev-dim);
  padding:20px 4px 4px;
}
.score{
  font-size:66px;
  line-height:.94;
  font-weight:600;
  letter-spacing:-.045em;
  padding:0 4px;
}
.score.dim{color:var(--dev-dim);opacity:.55}
.verdict{padding:6px 4px 0;font-size:15px;font-weight:500;letter-spacing:-.01em}
.verdict.warn{color:var(--dev-warn)}
.driver{
  padding:14px 4px 0;
  font-size:13.5px;
  line-height:1.45;
  color:#C6CDD8;
}
.driver em{font-style:normal;color:var(--dev-text);font-weight:500}
.link{
  display:inline-block;
  margin-top:9px;
  font-size:12.5px;
  color:var(--dev-accent);
  border-bottom:1px solid rgba(141,149,246,.35);
  padding-bottom:1px;
}
.action{
  margin:16px 4px 0;
  padding:12px 13px;
  background:var(--dev-raised);
  border-left:2px solid var(--dev-accent);
  font-size:13px;
  line-height:1.45;
  color:#D6DBE4;
  border-radius:0 4px 4px 0;
}

.tiles{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;background:var(--dev-line);margin:18px 0 0;border-top:1px solid var(--dev-line);border-bottom:1px solid var(--dev-line)}
.tile{background:var(--dev-surface);padding:12px 9px}
.tile .t-l{font-family:var(--mono);font-size:9.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--dev-dim)}
.tile .t-v{font-size:17px;font-weight:600;letter-spacing:-.02em;margin-top:5px}
.tile .t-d{font-family:var(--mono);font-size:10.5px;margin-top:3px;color:var(--dev-dim)}
.tile.muted .t-v{color:var(--dev-dim);opacity:.5}

.foot-meta{
  font-family:var(--mono);
  font-size:10px;
  color:var(--dev-dim);
  padding:14px 4px 0;
  line-height:1.5;
}

/* baseline state bits */
.prog{display:flex;gap:5px;padding:12px 4px 0}
.prog i{height:3px;flex:1;background:var(--dev-line);border-radius:2px}
.prog i.on{background:var(--dev-accent)}
.collected{margin:18px 0 0;border-top:1px solid var(--dev-line)}
.collected div{display:flex;justify-content:space-between;padding:9px 4px;border-bottom:1px solid var(--dev-line);font-size:12.5px;color:#C6CDD8}
.collected div span{font-family:var(--mono);font-size:11.5px;color:var(--dev-dim)}
.check{margin:16px 4px 0;font-size:12.5px;color:#C6CDD8;line-height:1.6}
.check b{display:block;font-family:var(--mono);font-size:9.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--dev-dim);margin-bottom:7px;font-weight:500}

/* ---------- metrics ---------- */
.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
@media(max-width:760px){.metrics{grid-template-columns:1fr}}
.metric{background:var(--panel);border:1px solid var(--rule);padding:20px}
.metric .m-l{font-family:var(--mono);font-size:10.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--ink-3)}
.metric .m-v{font-size:19px;font-weight:600;letter-spacing:-.02em;margin:8px 0 6px}
.metric p{font-size:13.5px;color:var(--ink-2);margin:0}

.events{font-family:var(--mono);font-size:12.5px;color:var(--ink-2);line-height:2}

/* ---------- close ---------- */
.close{padding:52px 0 0;border-bottom:0}
.close p{font-size:17px;line-height:1.55;max-width:58ch}

.disclaimer{
  margin-top:40px;
  padding-top:18px;
  border-top:1px solid var(--rule);
  font-family:var(--mono);
  font-size:11px;
  line-height:1.7;
  color:var(--ink-3);
  max-width:70ch;
}

/* motion */
.rv{opacity:0;transform:translateY(10px);transition:opacity .5s ease,transform .5s ease}
.rv.in{opacity:1;transform:none}
@media(prefers-reduced-motion:reduce){
  .rv{opacity:1;transform:none;transition:none}
}
</style>
